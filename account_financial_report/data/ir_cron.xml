<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_general_ledger" model="ir.cron">
            <field name="name">General Ledger Cron</field>
            <field name="model_id" search="[('model', '=', 'general.ledger.job.runner')]"/>
            <field name="state">code</field>
            <field name="code">model.cron_enqueue_jobs()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_general_ledger_delete" model="ir.cron">
            <field name="name">General Ledger DELETE Cron FILES</field>
            <field name="model_id" search="[('model', '=', 'general.ledger.job.runner')]"/>
            <field name="state">code</field>
            <field name="code">model.cron_delete_files()</field>
            <field name="interval_number">100</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">False</field>
        </record>

    </data>
</odoo>
