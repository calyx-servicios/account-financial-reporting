<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_ledger_report_file_tree" model="ir.ui.view">
        <field name="name">ledger.report.file.tree</field>
        <field name="model">general.ledger.job.runner</field>
        <field name="arch" type="xml">
            <tree string="Archivos libro mayor" edit="False" create="False" delete="False">
                <field name="name"/>
                <field name="disk_space"/>
                <field name="exec_time"/>
                <field name="extension_file"/>
                <field name="ccompany_id"/>
                <button string="Descargar" name="download_report" type="object" class="oe_highlight"/>
            </tree>
        </field>
    </record>

    <record id="ledger_report_file_action" model="ir.actions.server">
        <field name="name">Archivos libro mayor</field>
        <field name="model_id" ref="model_general_ledger_job_runner"/>
        <field name="state">code</field>
        <field name="code">
            action = model.action_open_ledger_reports()
        </field>
    </record>

</odoo>
